{
    "name": "snow-digital/laravel-json-api",
    "homepage": "https://github.com/snow-digital/laravel-json-api",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/snow-digital/laravel-json-api/issues",
        "source": "https://github.com/snow-digital/laravel-json-api"
    },
    "authors": [
        {
            "name": "Frédéric Vandebeuque",
            "email": "fred.vdb@newebtime.com",
            "homepage": "https://snowdigital.co.th",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.59|^13.0",
        "illuminate/http": "^12.59|^13.0",
        "illuminate/support": "^12.59|^13.0",
        "spatie/laravel-json-api-paginate": "^2.0",
        "spatie/laravel-package-tools": "^1.11",
        "spatie/laravel-query-builder": "^6.4"
    },
    "require-dev": {
        "dedoc/scramble": "^0.13",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SnowDigital\\JsonApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SnowDigital\\JsonApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --ansi --memory-limit=2G",
        "baseline": "vendor/bin/phpstan analyse --generate-baseline --memory-limit=2G",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "SnowDigital\\JsonApi\\JsonApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
