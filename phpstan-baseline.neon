parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:withTrashed\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/ApiController.php

		-
			message: '#^PHPDoc tag @return with type Illuminate\\Pagination\\LengthAwarePaginator&iterable\<SnowDigital\\JsonApi\\Resources\\JsonApiResource\> is incompatible with native type SnowDigital\\JsonApi\\Resources\\JsonApiCollection\.$#'
			identifier: return.phpDocType
			count: 1
			path: src/ApiController.php

		-
			message: '#^Call to an undefined method Dedoc\\Scramble\\Support\\Generator\\Types\\Type\:\:getProperty\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Docs/QueryBuilderToSchema.php

		-
			message: '#^Parameter \#1 \$reference of method Dedoc\\Scramble\\Support\\Generator\\Components\:\:get\(\) expects Dedoc\\Scramble\\Support\\Generator\\Reference, Dedoc\\Scramble\\Support\\Generator\\Types\\Type given\.$#'
			identifier: argument.type
			count: 1
			path: src/Docs/QueryBuilderToSchema.php
